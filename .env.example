# Copy to .env and fill in. .env is git-ignored: never commit it.

# Booking API. Read-only use. Testing uses the service admin's personal key.
BOOKING_API_BASE_URL=https://example.org
BOOKING_API_KEY=your-api-key-here

# Mail. Mailpit (local mail catcher) for testing:
#   docker run -d --name mailpit -p 8025:8025 -p 1025:1025 axllent/mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=false
MAIL_FROM=nano-standup@example.org

# SQLite file. A relative path is taken from this file's folder.
DATABASE_PATH=data/nano-standup.sqlite3

# Working day, Monday to Friday, as HH:MM. The Heads-up section points out reservations outside it.
# WORKING_DAY_START=07:00
# WORKING_DAY_END=19:00
