# Copy to .env and fill in. .env is git-ignored: never commit it.

# Booking API. Read-only use. Testing uses the service admin's personal key.
BOOKING_API_BASE_URL=https://example.org
BOOKING_API_KEY=your-api-key-here

# Mail. Mailpit (local mail catcher) for testing:
#   docker run -d --name mailpit -p 8025:8025 -p 1025:1025 axllent/mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=false
MAIL_FROM=nano-standup@example.org
# The service admin gets an error report when briefs still fail at 10:00 Prague time.
SERVICE_ADMIN_EMAIL=service-admin@example.org

# SQLite file. A relative path is taken from this file's folder.
DATABASE_PATH=data/nano-standup.sqlite3

# Working day, Monday to Friday, as HH:MM. The Heads-up section points out reservations outside it.
# WORKING_DAY_START=07:00
# WORKING_DAY_END=19:00

# A user's first reservations on an instrument, up to this many, are by a new user. The Heads-up section lists them.
# NEW_USER_RESERVATIONS=3

# Web app (nano-standup serve), where guarantors subscribe.
# The address guarantors open it at. Confirm links in the emails start with it. Needed only by serve.
PUBLIC_BASE_URL=http://localhost:8000
# Where it listens. Keep 127.0.0.1 behind an HTTPS proxy.
# WEB_HOST=127.0.0.1
# WEB_PORT=8000

# Only for the opt-in live API check (uv run --env-file .env pytest -m live_api): an instrument with recent reservations.
# LIVE_API_INSTRUMENT_ID=
